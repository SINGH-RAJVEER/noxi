# Replacement qualification VMs (TODO sections 7 and 8).
#
# Each mode boots the same CppNix-managed machine from its own disposable
# disk, swaps it to nix-rs, runs the mode's scenario, returns to CppNix and
# verifies the store. The report derivations record every passing, failing and
# blocked step and succeed whenever the scenario ran; the strict checks fail
# unless every step passed. See docs/verification.md.
{
	self,
	nixpkgs,
	home-manager,
	rust-overlay,
	nix-reference,
}:
let
	system = "x86_64-linux";
	# Context-free strings, as the guest writes them; see machines.nix.
	plain = input: builtins.unsafeDiscardStringContext input.outPath;
	sources = {
		nixpkgs = plain nixpkgs;
		home-manager = plain home-manager;
		rust-overlay = plain rust-overlay;
	};
	machines = import ./machines.nix sources;
	inherit (machines) pkgs generations;
	inherit (pkgs) lib;
	reference = nix-reference.packages.${system}.nix;

	# The part of the repository the guest evaluates machines.nix from.
	source = lib.fileset.toSource {
		root = ../../..;
		fileset = lib.fileset.unions [
			../../../.cargo
			../../../Cargo.lock
			../../../Cargo.toml
			../../../crates
			../../../THIRD_PARTY.md
			../../../nix
			./machines.nix
			./home.nix
		];
	};
	entry = pkgs.writeText "qualification-system.nix" ''
		# Generated by tests/qualification/replacement/test.nix.
		let
			machines = import ${source}/tests/qualification/replacement/machines.nix {
				nixpkgs = "${sources.nixpkgs}";
				home-manager = "${sources.home-manager}";
				rust-overlay = "${sources.rust-overlay}";
			};
		in
		builtins.mapAttrs (name: config: { inherit config; }) machines.generations
	'';
	# Real offline outputs, sharing the exact classic-mode configurations.
	# Control probes validate these with CppNix before the daemon handoff.
	flake = pkgs.writeTextDir "flake.nix" ''
		{
			inputs = {
				source = { url = "path:${source}"; flake = false; };
				nixpkgs = { url = "path:${sources.nixpkgs}"; flake = false; };
				home-manager = { url = "path:${sources.home-manager}"; flake = false; };
				rust-overlay = { url = "path:${sources.rust-overlay}"; flake = false; };
			};
			outputs = inputs:
				let
					plain = input: builtins.unsafeDiscardStringContext input.outPath;
					machines = import (inputs.source + "/tests/qualification/replacement/machines.nix") {
						nixpkgs = plain inputs.nixpkgs;
						home-manager = plain inputs.home-manager;
						rust-overlay = plain inputs.rust-overlay;
					};
				in {
					nixosConfigurations = builtins.mapAttrs (name: config: { inherit config; }) machines.generations;
					homeConfigurations.standalone = machines.home.configuration;
				};
		}
	'';
	built = lib.filterAttrs (name: _: name != "broken") generations;
	toplevel = name: generations.${name}.system.build.toplevel;
	expected = builtins.toJSON {
		generations = lib.mapAttrs (name: _: {
			drv = builtins.unsafeDiscardStringContext (toplevel name).drvPath;
			out = builtins.unsafeDiscardStringContext (toplevel name).outPath;
		}) built;
		home = {
			config = builtins.unsafeDiscardStringContext machines.home.config;
			drv = builtins.unsafeDiscardStringContext machines.home.activation.drvPath;
			out = builtins.unsafeDiscardStringContext machines.home.activation.outPath;
		};
		candidate = builtins.unsafeDiscardStringContext machines.candidate.outPath;
		upgrade = builtins.unsafeDiscardStringContext machines.upgrade.outPath;
		inherit reference;
	};

	# The booted machine: CppNix, with every generation and source the guest
	# needs already in its store, so it evaluates and builds nothing new.
	base = {
		imports = [ machines.common ];
		nix.package = reference;
		environment.etc."qualification/system.nix".source = entry;
		environment.etc."qualification/flake".source = flake;
		environment.etc."qualification/expected.json".text = expected;
		system.extraDependencies = [
			machines.candidate
			machines.upgrade
			machines.home.activation
			machines.home.config
			machines.home.configuration.config.news.json.output
			source
			nixpkgs
			home-manager
			rust-overlay
		] ++ map toplevel (builtins.attrNames built);
	};

	modes = [
		"nixos"
		"home-manager"
		"lifecycle"
	];
	report =
		mode:
		pkgs.testers.runNixOSTest {
			name = "nixrs-qualification-${mode}";
			nodes.machine = base;
			testScript = "MODE = ${builtins.toJSON mode}\n" + builtins.readFile ./script.py;
		};
	reports = lib.genAttrs modes report;
	strict =
		mode:
		pkgs.runCommand "nixrs-qualification-${mode}-gate" { nativeBuildInputs = [ pkgs.jq ]; } ''
			report=${reports.${mode}}/report.json
			jq -r '.steps[] | "\(.status)\t\(.name)"' "$report"
			jq -e '.schema == 2 and (.steps | length > 0) and all(.steps[]; .status == "pass")' "$report" > /dev/null
			mkdir -p "$out"
			cp "$report" "$out/report.json"
		'';
in
{
	inherit (machines) candidate;
	fixtures = { inherit flake; };
	inherit reports;
	checks = lib.genAttrs modes strict;
	configurations = lib.mapAttrs' (name: config: {
		name = "qualification-${name}";
		value = { inherit config; };
	}) built;
	home = machines.home;
}
